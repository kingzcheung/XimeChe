# shellcheck shell=bash
# pacman 安装/升级/卸载钩子。注意：脚本的工作目录是 /。
#
# 不要在这里调 update-desktop-database / gtk-update-icon-cache：
# 两者都由 pacman 的 file trigger 钩子自动完成（namcap 会报
# ".INSTALL file runs a command ... provided by hooks"），而且 Arch
# 基础系统里没有 gtk-update-icon-cache 可执行文件，调了只会刷
# "command not found"。

post_install() {
    cat <<'EOF'
==> 曦码已安装。在 KDE Plasma 中启用：

      kwriteconfig6 --file kwinrc --group Wayland --key VirtualKeyboard xime-launcher.desktop
      qdbus6 org.kde.KWin /KWin reconfigure

    若未生效请注销后重新登录（KWin 只在启动时装配虚拟键盘）。
    输入法设置界面：xime-setup
EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    :
}
